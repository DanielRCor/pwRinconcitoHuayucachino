---
import Base from '../layouts/Base.astro';
import { site } from '../config';

const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hola, quisiera reservar una mesa en Rinconcito Huayucachino')}`;
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(site.mapsQuery)}&output=embed`;

// Contenido por defecto: lo ven Google y los visitantes hasta que el panel cargue el suyo
const casaTitle = 'La casa';
const casaText =
  'Rinconcito Huayucachino es un restaurante familiar en Carapongo, Lurigancho - Chosica. Cocinamos la sazón de Huayucachi y el valle del Mantaro como en casa, con leña, y abrimos la tarima a artistas para que la sobremesa se vuelva fiesta.';
const defaultDishes = [
  { name: 'Pachamanca a la tierra', description: 'Tres carnes, habas, humita y camote' },
  { name: 'Patasca huanca', description: 'Mote, mondongo y hierbabuena' },
  { name: 'Papa a la huancaína', description: 'Con ají amarillo y queso fresco' },
  { name: 'Trucha frita', description: 'Con papas nativas y ensalada' },
];
const bandWords = ['Música en vivo', 'Cocina huanca', 'Huaylas', 'Orquestas'];
// Cada mitad de la cinta repite las palabras 3 veces para cubrir pantallas anchas sin cortes
const bandGroup = [...bandWords, ...bandWords, ...bandWords];
---

<Base title={`${site.name} | Restaurante y música en vivo en Carapongo, Chosica`}>
  <header class="topbar">
    <div class="wrap topbar__inner">
      <!-- Único h1 de la página, siempre visible: el nombre del restaurante -->
      <h1 class="logo">
        <a href="/">
          <span class="logo__small">Rinconcito</span>
          <span class="logo__big">Huayucachino</span>
        </a>
      </h1>
      <nav class="nav" aria-label="Principal">
        <a href="#agenda">Agenda</a>
        <a href="#casa">La casa</a>
        <a href="#llegar">Cómo llegar</a>
      </nav>
    </div>
  </header>

  <main>
    <!-- HERO: se reemplaza con el evento destacado cuando existe -->
    <section class="hero" id="hero" data-state="brand">
      <div class="hero__bg" id="hero-bg" aria-hidden="true"></div>
      <div class="hero__rombos" aria-hidden="true"></div>

      <div class="wrap hero__brand">
        <p class="hero__kicker">Restaurante campestre y música en vivo en Carapongo, Lurigancho - Chosica</p>
        <p class="stack" aria-hidden="true">
          <span class="stack__b">Rinconcito</span>
          <span class="stack__c">Huayucachino</span>
        </p>
        <p class="hero__lead">
          Pachamanca, patasca y la sazón del valle del Mantaro, con una tarima donde suben orquestas,
          huaylas y cumbia.
        </p>
        <div class="hero__actions">
          <a class="btn btn--lg" href={wa} target="_blank" rel="noopener">Reservar por WhatsApp</a>
          <a class="btn btn--lg btn--ghost" href="#agenda">Ver agenda</a>
        </div>
      </div>

      <div class="wrap hero__event" id="hero-event" hidden>
        <div class="hero__info">
          <p class="when" id="hero-when"></p>
          <h2 class="hero__artist" id="hero-artist"></h2>
          <p class="hero__title" id="hero-title"></p>
          <p class="hero__desc" id="hero-desc"></p>
          <div class="hero__actions">
            <a class="btn btn--lg" id="hero-cta" href={wa} target="_blank" rel="noopener">Reservar mesa</a>
            <a class="btn btn--lg btn--ghost" href="#agenda">Más fechas</a>
          </div>
        </div>
        <figure class="hero__poster">
          <img id="hero-img" alt="" />
        </figure>
      </div>
    </section>

    <div class="band" aria-hidden="true">
      <div class="band__track">
        {[0, 1].map(() => (
          <div class="band__group">
            {bandGroup.map((w) => <span>{w}</span>)}
          </div>
        ))}
      </div>
    </div>

    <section class="agenda" id="agenda">
      <div class="wrap">
        <h2 class="section-title">Agenda de eventos</h2>
      </div>
      <ol class="covers" id="dates">
        <li class="wrap covers__empty">Cargando fechas…</li>
      </ol>
    </section>

    <div class="tejido" aria-hidden="true"></div>

    <section class="casa" id="casa">
      <div class="wrap casa__intro">
        <h2 class="section-title" id="casa-title">{casaTitle}</h2>
        <p class="casa__text" id="casa-text">{casaText}</p>
      </div>

      <div class="carrusel" id="carrusel" aria-label="Platos de la casa" data-paused="false">
        <div class="carrusel__track" id="carrusel-track">
          {defaultDishes.map((d) => (
            <article class="plato">
              <div class="plato__img plato__img--vacio" aria-hidden="true"></div>
              <h3 class="plato__name">{d.name}</h3>
              <p class="plato__desc">{d.description}</p>
            </article>
          ))}
        </div>
      </div>
      <p class="wrap carrusel__hint" id="carrusel-hint">Pasa el mouse o toca un plato para detener el carrusel.</p>
    </section>

    <div class="tejido" aria-hidden="true"></div>

    <section class="llegar" id="llegar">
      <div class="wrap llegar__grid">
        <div>
          <h2 class="section-title">Cómo llegar</h2>
          <address class="llegar__addr">{site.address}</address>
          <dl class="horario">
            {site.hours.map((h) => (
              <div>
                <dt>{h.days}</dt>
                <dd>{h.time}</dd>
              </div>
            ))}
          </dl>
          <div class="hero__actions">
            <a class="btn btn--lg" href={wa} target="_blank" rel="noopener">Escribir al {site.phoneLabel}</a>
            <a class="btn btn--lg btn--ghost" href={site.mapsUrl} target="_blank" rel="noopener">Abrir en Google Maps</a>
          </div>
        </div>
        <iframe
          class="map"
          title={`Mapa de ${site.name}`}
          src={mapSrc}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </section>
  </main>

  <div class="tejido tejido--fino" aria-hidden="true"></div>
  <footer class="footer">
    <div class="wrap footer__inner">
      <p>© {new Date().getFullYear()} {site.name} · Carapongo, Lurigancho - Chosica</p>
      <nav aria-label="Redes sociales" class="footer__social">
        <a href={site.facebook} target="_blank" rel="noopener" aria-label="Facebook">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M14 8h3V4h-3c-2.8 0-4 1.9-4 4.5V11H7v4h3v9h4v-9h3l.5-4H14V9c0-.6.4-1 1-1z"/></svg>
          <span>Facebook</span>
        </a>
        <a href={site.instagram} target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 7.3A4.7 4.7 0 1 0 12 16.7 4.7 4.7 0 0 0 12 7.3zm0 7.7a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm4.9-8a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0zM12 3c-2.4 0-2.7 0-3.7.1C5.7 3.2 3.2 5.7 3.1 8.3 3 9.3 3 9.6 3 12s0 2.7.1 3.7c.1 2.6 2.6 5.1 5.2 5.2 1 .1 1.3.1 3.7.1s2.7 0 3.7-.1c2.6-.1 5.1-2.6 5.2-5.2.1-1 .1-1.3.1-3.7s0-2.7-.1-3.7c-.1-2.6-2.6-5.1-5.2-5.2C14.7 3 14.4 3 12 3zm0 1.6c2.4 0 2.6 0 3.6.1 1.8.1 3.6 1.9 3.7 3.7.1 1 .1 1.2.1 3.6s0 2.6-.1 3.6c-.1 1.8-1.9 3.6-3.7 3.7-1 .1-1.2.1-3.6.1s-2.6 0-3.6-.1c-1.8-.1-3.6-1.9-3.7-3.7-.1-1-.1-1.2-.1-3.6s0-2.6.1-3.6c.1-1.8 1.9-3.6 3.7-3.7 1-.1 1.2-.1 3.6-.1z"/></svg>
          <span>Instagram</span>
        </a>
        <a href={site.tiktok} target="_blank" rel="noopener" aria-label="TikTok">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M16.6 3h-3.3v12.4a2.8 2.8 0 1 1-2-2.7V9.3a6.1 6.1 0 1 0 5.3 6.1V9.1a7.9 7.9 0 0 0 4.4 1.4V7.2a4.5 4.5 0 0 1-4.4-4.2z"/></svg>
          <span>TikTok</span>
        </a>
      </nav>
    </div>
  </footer>
</Base>

<script>
  import {
    supabase, escapeHtml, formatDay, formatMonth, formatLong,
    type EventRow, type DishRow,
  } from '../lib/supabase';
  import { site } from '../config';

  const $ = (id: string) => document.getElementById(id)!;
  const waLink = (msg: string) => `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(msg)}`;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- Hero ---------- */
  function renderHero(ev: EventRow) {
    const hero = $('hero');
    $('hero-when').textContent = formatLong(ev.event_date);
    $('hero-artist').textContent = ev.artist;
    $('hero-title').textContent = ev.title;
    $('hero-desc').textContent = ev.description ?? '';
    ($('hero-cta') as HTMLAnchorElement).href = waLink(`Hola, quisiera reservar para ${ev.artist} (${formatLong(ev.event_date)})`);

    if (ev.image_url) {
      const img = $('hero-img') as HTMLImageElement;
      img.src = ev.image_url;
      img.alt = `Afiche: ${ev.artist}, ${ev.title}`;
      $('hero-bg').style.backgroundImage = `url("${ev.image_url}")`;
    } else {
      hero.classList.add('hero--noimg');
    }
    $('hero-event').hidden = false;
    hero.dataset.state = 'event';
  }

  /* ---------- Agenda: cada fecha como portada ---------- */
  function renderDates(events: EventRow[]) {
    const list = $('dates');
    if (!events.length) {
      list.innerHTML = `<li class="wrap covers__empty">Pronto anunciamos nuevas fechas. Síguenos en Facebook para enterarte primero.</li>`;
      return;
    }
    list.innerHTML = events.map((ev) => {
      const img = ev.image_url ? escapeHtml(ev.image_url) : '';
      const reservar = waLink(`Hola, quisiera reservar para ${ev.artist} (${formatLong(ev.event_date)})`);
      return `
      <li class="cover ${img ? '' : 'cover--noimg'}">
        ${img ? `<div class="cover__bg" style="background-image:url('${img}')" aria-hidden="true"></div>` : ''}
        <div class="wrap cover__inner">
          ${img ? `<figure class="cover__poster"><img src="${img}" alt="Afiche: ${escapeHtml(ev.artist)}" loading="lazy" /></figure>` : ''}
          <div class="cover__info">
            <time class="cover__cal" datetime="${ev.event_date}">
              <span class="cover__day">${formatDay(ev.event_date)}</span>
              <span class="cover__month">${formatMonth(ev.event_date)}</span>
            </time>
            <p class="when">${formatLong(ev.event_date)}</p>
            <h3 class="cover__artist">${escapeHtml(ev.artist)}</h3>
            <p class="cover__title">${escapeHtml(ev.title)}</p>
            ${ev.description ? `<p class="cover__desc">${escapeHtml(ev.description)}</p>` : ''}
            <a class="btn btn--lg" href="${reservar}" target="_blank" rel="noopener">Reservar mesa</a>
          </div>
        </div>
      </li>`;
    }).join('');
  }

  /* ---------- La casa ---------- */
  async function loadCasa() {
    if (!supabase) return;
    const [{ data: content }, { data: dishes }] = await Promise.all([
      supabase.from('site_content').select('key,value'),
      supabase.from('dishes').select('*').order('position').order('created_at'),
    ]);
    for (const row of content ?? []) {
      if (row.key === 'casa_title' && row.value) $('casa-title').textContent = row.value;
      if (row.key === 'casa_text' && row.value) $('casa-text').textContent = row.value;
    }
    if (dishes?.length) renderDishes(dishes as DishRow[]);
  }

  function dishCard(d: DishRow) {
    return `
      <article class="plato" tabindex="0">
        ${d.image_url
          ? `<img class="plato__img" src="${escapeHtml(d.image_url)}" alt="${escapeHtml(d.name)}" loading="lazy" />`
          : `<div class="plato__img plato__img--vacio" aria-hidden="true"></div>`}
        <h3 class="plato__name">${escapeHtml(d.name)}</h3>
        ${d.description ? `<p class="plato__desc">${escapeHtml(d.description)}</p>` : ''}
      </article>`;
  }

  function renderDishes(dishes: DishRow[]) {
    $('carrusel-track').innerHTML = dishes.map(dishCard).join('');
    startCarousel();
  }

  /* ---------- Carrusel continuo de platos ----------
     Se duplica el contenido y se desplaza en bucle: al llegar a la mitad vuelve a 0
     sin salto visible. Se detiene con el mouse encima o tocando un plato. */
  let rafId = 0;
  let hover = false;
  let pinned: Element | null = null;
  const box = $('carrusel');
  const track = $('carrusel-track');

  const setPaused = () => (box.dataset.paused = String(hover || !!pinned));
  const unpin = () => {
    pinned?.classList.remove('plato--activo');
    pinned = null;
  };
  box.addEventListener('mouseenter', () => { hover = true; setPaused(); });
  box.addEventListener('mouseleave', () => { hover = false; setPaused(); });
  box.addEventListener('click', (e) => {
    const card = (e.target as HTMLElement).closest('.plato');
    const same = card === pinned;
    unpin();
    if (card && !same) {
      pinned = card;
      card.classList.add('plato--activo');
    }
    setPaused();
  });
  // Al tocar fuera del carrusel, vuelve a moverse
  document.addEventListener('click', (e) => {
    if (pinned && !box.contains(e.target as Node)) {
      unpin();
      setPaused();
    }
  });

  function startCarousel() {
    cancelAnimationFrame(rafId);
    unpin();
    if (reduceMotion) {
      box.classList.add('carrusel--manual');
      return;
    }

    const originals = Array.from(track.children)
      .filter((el) => !el.hasAttribute('aria-hidden'))
      .map((el) => el.outerHTML);
    if (!originals.length) return;
    // Repetir hasta cubrir más que el ancho visible y luego duplicar el grupo completo
    let group = [...originals];
    track.innerHTML = group.join('');
    while (track.scrollWidth < box.clientWidth + 400 && group.length < 60) {
      group = [...group, ...originals];
      track.innerHTML = group.join('');
    }
    track.innerHTML = group.join('') + group.map((h) => h.replace('<article', '<article aria-hidden="true"')).join('');

    let offset = 0;
    let last = performance.now();
    const speed = 45; // px por segundo

    const tick = (now: number) => {
      const dt = Math.min(now - last, 64) / 1000;
      last = now;
      if (!hover && !pinned) {
        const half = track.scrollWidth / 2;
        offset = (offset + speed * dt) % half;
        track.style.transform = `translate3d(${-offset}px,0,0)`;
      }
      rafId = requestAnimationFrame(tick);
    };
    rafId = requestAnimationFrame(tick);
  }

  /* ---------- Carga ---------- */
  async function loadEvents() {
    if (!supabase) return renderDates([]);
    const since = new Date(Date.now() - 12 * 3600 * 1000).toISOString();
    const { data, error } = await supabase
      .from('events')
      .select('*')
      .gte('event_date', since)
      .order('event_date', { ascending: true });
    if (error || !data) return renderDates([]);
    const events = data as EventRow[];
    const featured = events.find((e) => e.is_featured);
    if (featured) renderHero(featured);
    renderDates(events);
  }

  startCarousel();
  loadEvents();
  loadCasa();
</script>

<style>
  /* ---------- Barra superior ---------- */
  .topbar {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 10;
    padding-block: 18px;
  }
  .topbar__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px 16px;
  }
  .logo { margin: 0; font: inherit; }
  .logo a { text-decoration: none; display: grid; line-height: 1; }
  .logo__small { font-size: .9rem; font-weight: 800; color: var(--amarillo); }
  .logo__big { font-family: var(--display); font-size: 1.45rem; color: var(--papel); }

  .nav { display: flex; flex-wrap: wrap; gap: 10px; }
  .nav a {
    font-family: var(--display);
    font-size: 1.05rem;
    text-decoration: none;
    padding: .7em 1.25em;
    border-radius: 999px;
    background: rgba(27, 15, 46, .55);
    box-shadow: inset 0 0 0 2px rgba(255, 246, 229, .35);
    backdrop-filter: blur(8px);
    transition: background .15s ease, color .15s ease, box-shadow .15s ease;
  }
  .nav a:hover { background: var(--amarillo); color: var(--noche); box-shadow: inset 0 0 0 2px var(--amarillo); }
  @media (max-width: 640px) {
    .topbar__inner { justify-content: center; }
    .nav { justify-content: center; width: 100%; gap: 8px; }
    .nav a { font-size: .9rem; padding: .65em 1em; }
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    min-height: min(100svh, 1000px);
    display: grid;
    align-items: center;
    padding-block: 120px 64px;
    isolation: isolate;
    overflow: hidden;
  }
  @media (max-width: 640px) { .hero { padding-top: 170px; } }
  .hero__bg {
    position: absolute;
    inset: -40px;
    z-index: -2;
    background:
      radial-gradient(60% 50% at 85% 20%, rgba(255, 61, 154, .45), transparent 70%),
      radial-gradient(50% 60% at 10% 90%, rgba(61, 224, 138, .25), transparent 70%),
      var(--noche);
    background-size: cover;
    background-position: center;
  }
  .hero__rombos {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--rombos);
    opacity: .06;
    mask-image: linear-gradient(to bottom, #000, transparent 85%);
  }
  .hero[data-state='event'] .hero__bg {
    filter: blur(40px) saturate(1.4) brightness(.42);
    transform: scale(1.1);
  }
  .hero[data-state='event'] .hero__brand { display: none; }

  .hero__kicker { color: var(--verde); font-weight: 600; font-size: 1.1rem; margin: 0 0 18px; }

  .stack { margin: 0 0 28px; font-family: var(--display); line-height: 1; display: grid; justify-items: start; gap: 6px; }
  .stack span { display: inline-block; padding: .08em .22em .02em; line-height: 1; }
  .stack__b { background: var(--fucsia); color: var(--papel); font-size: clamp(2.6rem, 9vw, 7rem); transform: rotate(-2deg); }
  .stack__c { background: var(--amarillo); color: var(--noche); font-size: clamp(2.1rem, 7.4vw, 5.8rem); }

  .hero__lead { max-width: 52ch; font-size: 1.15rem; color: var(--papel-dim); margin: 0 0 32px; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; }

  .hero__event {
    display: grid;
    grid-template-columns: .85fr 1.15fr;
    gap: clamp(24px, 5vw, 64px);
    align-items: center;
    max-width: 1400px;
    animation: rise .8s cubic-bezier(.2, .8, .2, 1) both;
  }
  .hero__event[hidden] { display: none; }

  .when {
    display: inline-block;
    background: var(--amarillo);
    color: var(--noche);
    font-weight: 800;
    padding: .35em .75em;
    margin: 0 0 20px;
    font-size: 1.05rem;
  }
  .when::first-letter { text-transform: uppercase; }

  .hero__artist {
    font-size: clamp(2.6rem, 7vw, 6rem);
    color: var(--papel);
    text-shadow: 4px 4px 0 var(--fucsia);
    overflow-wrap: anywhere;
    margin-bottom: 16px;
  }
  .hero__title { font-size: clamp(1.2rem, 2.4vw, 1.6rem); font-weight: 800; color: var(--verde); margin: 0 0 12px; }
  .hero__desc { color: var(--papel-dim); max-width: 48ch; margin: 0 0 28px; white-space: pre-line; }
  .hero__poster { margin: 0; justify-self: center; width: 100%; max-width: 720px; }
  .hero__poster img {
    width: 100%;
    max-height: 84svh;
    object-fit: contain;
    box-shadow: 14px 14px 0 var(--fucsia), 0 30px 60px rgba(0, 0, 0, .5);
  }
  .hero--noimg .hero__poster { display: none; }
  .hero--noimg .hero__event { grid-template-columns: 1fr; }

  @keyframes rise {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: none; }
  }
  @media (max-width: 860px) {
    .hero__event { grid-template-columns: 1fr; }
    .hero__poster { order: -1; }
    .hero__poster img { max-height: 70svh; box-shadow: 8px 8px 0 var(--fucsia); }
  }

  /* ---------- Cinta continua ---------- */
  .band {
    background: var(--fucsia);
    color: var(--noche);
    font-family: var(--display);
    font-size: clamp(1rem, 2.4vw, 1.5rem);
    overflow: hidden;
    padding-block: 12px;
    transform: rotate(-1.2deg);
    margin-inline: -20px;
    white-space: nowrap;
  }
  .band__track { display: flex; width: max-content; animation: slide 40s linear infinite; }
  .band__group { display: flex; flex: none; }
  /* Cada palabra lleva su separador y su espacio, así las dos mitades miden exactamente igual */
  .band__group span { padding-right: 1.2em; }
  .band__group span::after { content: '◆'; margin-left: 1.2em; color: var(--amarillo); }
  @keyframes slide { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* ---------- Secciones ---------- */
  .section-title { font-size: clamp(2.2rem, 6vw, 4rem); color: var(--amarillo); margin-bottom: 32px; }
  .agenda, .casa, .llegar { padding-block: clamp(64px, 10vw, 120px); }

  /* ---------- Agenda: portadas apiladas ---------- */
  .covers { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(20px, 4vw, 40px); }
  .covers :global(.covers__empty) { color: var(--papel-dim); font-size: 1.15rem; }
  .covers :global(.cover) {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(32px, 6vw, 72px);
    background: var(--noche-2);
  }
  .covers :global(.cover__bg) {
    position: absolute;
    inset: -40px;
    z-index: -1;
    background-size: cover;
    background-position: center;
    filter: blur(36px) saturate(1.3) brightness(.4);
  }
  .covers :global(.cover__inner) {
    display: grid;
    grid-template-columns: 1.15fr .85fr;
    gap: clamp(24px, 5vw, 64px);
