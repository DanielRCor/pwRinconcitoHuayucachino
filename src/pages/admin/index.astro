---
import Base from '../../layouts/Base.astro';
---

<Base title="Panel · Rinconcito Huayucachino" noindex>
  <div class="admin">
    <!-- Sin configuración -->
    <section class="card center" id="view-config" hidden>
      <h1>Falta configurar Supabase</h1>
      <p>Agrega <code>PUBLIC_SUPABASE_URL</code> y <code>PUBLIC_SUPABASE_ANON_KEY</code> en las variables de entorno y vuelve a desplegar.</p>
    </section>

    <!-- Login -->
    <section class="card center login" id="view-login" hidden>
      <a href="/" class="back">Volver a la web</a>
      <h1>Panel de eventos</h1>
      <form id="login-form" class="form">
        <label>Correo
          <input type="email" name="email" autocomplete="username" required />
        </label>
        <label>Contraseña
          <input type="password" name="password" autocomplete="current-password" required />
        </label>
        <p class="msg" id="login-msg" role="alert"></p>
        <button class="btn" type="submit">Entrar</button>
      </form>
    </section>

    <!-- Panel -->
    <section id="view-panel" hidden>
      <header class="bar">
        <h1>Eventos</h1>
        <div class="bar__right">
          <a href="/" target="_blank" rel="noopener">Ver web</a>
          <button class="link" id="logout">Cerrar sesión</button>
        </div>
      </header>

      <div class="grid">
        <form id="event-form" class="card form">
          <h2 id="form-title">Nuevo evento</h2>
          <input type="hidden" name="id" />

          <label class="drop" id="drop">
            <input type="file" name="image" accept="image/*" id="image-input" />
            <img id="preview" alt="Vista previa del afiche" hidden />
            <span id="drop-text">Sube el afiche o una foto grande del artista (vertical o horizontal)</span>
          </label>

          <label>Artista o agrupación
            <input name="artist" required maxlength="120" placeholder="Ej. Orquesta Los Gorriones del Mantaro" />
          </label>
          <label>Nombre del evento
            <input name="title" required maxlength="160" placeholder="Ej. Noche de huaylas" />
          </label>
          <label>Fecha y hora
            <input type="datetime-local" name="event_date" required />
          </label>
          <label>Descripción (opcional)
            <textarea name="description" rows="4" maxlength="1000" placeholder="Entrada, cover, menú especial…"></textarea>
          </label>

          <label class="check">
            <input type="checkbox" name="is_featured" />
            <span>Mostrar en grande al inicio de la web</span>
          </label>
          <label class="check">
            <input type="checkbox" name="is_published" checked />
            <span>Publicado (visible en la web)</span>
          </label>

          <p class="msg" id="form-msg" role="status"></p>
          <div class="actions">
            <button class="btn" type="submit" id="save">Publicar evento</button>
            <button class="btn btn--ghost" type="button" id="cancel" hidden>Cancelar edición</button>
          </div>
        </form>

        <div>
          <h2 class="list-title">Fechas cargadas</h2>
          <ul class="list" id="list"></ul>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  import { supabase, isConfigured, BUCKET, formatLong, escapeHtml, type EventRow } from '../../lib/supabase';

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const views = ['view-config', 'view-login', 'view-panel'];
  const show = (id: string) => views.forEach((v) => ($(v).hidden = v !== id));

  const form = $<HTMLFormElement>('event-form');
  const preview = $<HTMLImageElement>('preview');
  const formMsg = $('form-msg');
  let events: EventRow[] = [];
  let currentImageUrl: string | null = null;

  function toLocalInput(iso: string) {
    const d = new Date(iso);
    const off = d.getTimezoneOffset();
    return new Date(d.getTime() - off * 60000).toISOString().slice(0, 16);
  }

  function resetForm() {
    form.reset();
    (form.elements.namedItem('id') as HTMLInputElement).value = '';
    currentImageUrl = null;
    preview.hidden = true;
    preview.removeAttribute('src');
    $('drop-text').hidden = false;
    $('form-title').textContent = 'Nuevo evento';
    $('save').textContent = 'Publicar evento';
    $('cancel').hidden = true;
    formMsg.textContent = '';
  }

  function editEvent(ev: EventRow) {
    const f = form.elements as any;
    f.id.value = ev.id;
    f.artist.value = ev.artist;
    f.title.value = ev.title;
    f.description.value = ev.description ?? '';
    f.event_date.value = toLocalInput(ev.event_date);
    f.is_featured.checked = ev.is_featured;
    f.is_published.checked = ev.is_published;
    currentImageUrl = ev.image_url;
    if (ev.image_url) {
      preview.src = ev.image_url;
      preview.hidden = false;
      $('drop-text').hidden = true;
    }
    $('form-title').textContent = 'Editar evento';
    $('save').textContent = 'Guardar cambios';
    $('cancel').hidden = false;
    form.scrollIntoView({ behavior: 'smooth' });
  }

  function renderList() {
    const list = $('list');
    if (!events.length) {
      list.innerHTML = '<li class="empty">Aún no hay eventos. Crea el primero con el formulario.</li>';
      return;
    }
    const now = Date.now();
    list.innerHTML = events.map((ev) => {
      const past = new Date(ev.event_date).getTime() < now - 12 * 3600 * 1000;
      return `
      <li class="item ${past ? 'item--past' : ''}">
        ${ev.image_url ? `<img src="${escapeHtml(ev.image_url)}" alt="" />` : '<div class="noimg"></div>'}
        <div class="item__body">
          <strong>${escapeHtml(ev.artist)}</strong>
          <span>${escapeHtml(ev.title)}</span>
          <small>${formatLong(ev.event_date)}</small>
          <div class="tags">
            ${ev.is_featured ? '<em class="tag tag--hot">En portada</em>' : ''}
            ${ev.is_published ? '' : '<em class="tag">Oculto</em>'}
            ${past ? '<em class="tag">Pasado</em>' : ''}
          </div>
        </div>
        <div class="item__actions">
          <button class="link" data-edit="${ev.id}">Editar</button>
          <button class="link danger" data-del="${ev.id}">Eliminar</button>
        </div>
      </li>`;
    }).join('');
  }

  async function loadEvents() {
    const { data, error } = await supabase!.from('events').select('*').order('event_date', { ascending: false });
    if (error) {
      $('list').innerHTML = `<li class="empty">No se pudieron cargar los eventos: ${escapeHtml(error.message)}</li>`;
      return;
    }
    events = data as EventRow[];
    renderList();
  }

  async function uploadImage(file: File) {
    const ext = file.name.split('.').pop()?.toLowerCase() || 'jpg';
    const path = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}.${ext}`;
    const { error } = await supabase!.storage.from(BUCKET).upload(path, file, { cacheControl: '31536000', contentType: file.type });
    if (error) throw error;
    return supabase!.storage.from(BUCKET).getPublicUrl(path).data.publicUrl;
  }

  async function removeImage(url: string | null) {
    if (!url) return;
    const marker = `/${BUCKET}/`;
    const i = url.indexOf(marker);
    if (i === -1) return;
    await supabase!.storage.from(BUCKET).remove([url.slice(i + marker.length)]);
  }

  async function init() {
    if (!isConfigured || !supabase) return show('view-config');

    const { data } = await supabase.auth.getSession();
    if (data.session) {
      show('view-panel');
      loadEvents();
    } else {
      show('view-login');
    }

    $<HTMLFormElement>('login-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(e.currentTarget as HTMLFormElement);
      $('login-msg').textContent = '';
      const { error } = await supabase.auth.signInWithPassword({
        email: String(fd.get('email')),
        password: String(fd.get('password')),
      });
      if (error) {
        $('login-msg').textContent = 'Correo o contraseña incorrectos. Revisa los datos e inténtalo otra vez.';
        return;
      }
      show('view-panel');
      loadEvents();
    });

    $('logout').addEventListener('click', async () => {
      await supabase.auth.signOut();
      show('view-login');
    });

    $<HTMLInputElement>('image-input').addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;
      preview.src = URL.createObjectURL(file);
      preview.hidden = false;
      $('drop-text').hidden = true;
    });

    $('cancel').addEventListener('click', resetForm);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = form.elements as any;
      const btn = $<HTMLButtonElement>('save');
      const label = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Guardando…';
      formMsg.textContent = '';

      try {
        const file: File | undefined = f.image.files?.[0];
        if (file && file.size > 8 * 1024 * 1024) throw new Error('La imagen pesa más de 8 MB. Usa una más liviana.');

        let image_url = currentImageUrl;
        if (file) {
          image_url = await uploadImage(file);
          if (currentImageUrl) await removeImage(currentImageUrl);
        }

        const row = {
          artist: f.artist.value.trim(),
          title: f.title.value.trim(),
          description: f.description.value.trim() || null,
          event_date: new Date(f.event_date.value).toISOString(),
          is_featured: f.is_featured.checked,
          is_published: f.is_published.checked,
          image_url,
        };

        // Solo un evento puede estar en portada
        if (row.is_featured) {
          await supabase.from('events').update({ is_featured: false }).eq('is_featured', true);
        }

        const id = f.id.value;
        const { error } = id
          ? await supabase.from('events').update(row).eq('id', id)
          : await supabase.from('events').insert(row);
        if (error) throw error;

        resetForm();
        formMsg.textContent = id ? 'Cambios guardados.' : 'Evento publicado.';
        await loadEvents();
      } catch (err: any) {
        formMsg.textContent = `No se guardó: ${err.message ?? err}`;
      } finally {
        btn.disabled = false;
        if (btn.textContent === 'Guardando…') btn.textContent = label;
      }
    });

    $('list').addEventListener('click', async (e) => {
      const t = e.target as HTMLElement;
      const editId = t.dataset.edit;
      const delId = t.dataset.del;
      if (editId) {
        const ev = events.find((x) => x.id === editId);
        if (ev) editEvent(ev);
      }
      if (delId) {
        const ev = events.find((x) => x.id === delId);
        if (!ev || !confirm(`¿Eliminar "${ev.artist} – ${ev.title}"? No se puede deshacer.`)) return;
        const { error } = await supabase.from('events').delete().eq('id', delId);
        if (error) return alert(`No se eliminó: ${error.message}`);
        await removeImage(ev.image_url);
        await loadEvents();
      }
    });
  }

  init();
</script>

<style>
  .admin {
    max-width: 1200px;
    margin-inline: auto;
    padding: 24px var(--gutter) 64px;
  }
  h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); color: var(--amarillo); }
  h2 { font-size: 1.3rem; margin-bottom: 8px; }
  .card {
    background: var(--noche-2);
    padding: clamp(20px, 4vw, 32px);
    border-radius: 6px;
  }
  .center { max-width: 440px; margin: 10vh auto 0; }
  .login h1 { margin-block: 12px 24px; }
  .back { color: var(--papel-dim); font-size: .95rem; }

  .form { display: grid; gap: 16px; }
  .form label { display: grid; gap: 6px; font-weight: 600; font-size: .95rem; }
  input, textarea {
    font: inherit;
    font-weight: 400;
    color: var(--papel);
    background: var(--noche);
    border: 2px solid rgba(255, 246, 229, .2);
    border-radius: 4px;
    padding: 10px 12px;
    width: 100%;
  }
  input:focus, textarea:focus { border-color: var(--amarillo); outline: none; }
  input[type='datetime-local'] { color-scheme: dark; }
  .form .check { display: flex; align-items: center; gap: 10px; font-weight: 400; }
  .check input { width: 20px; height: 20px; accent-color: var(--fucsia); }

  .drop {
    position: relative;
    display: grid !important;
    place-items: center;
    min-height: 200px;
    border: 2px dashed var(--fucsia) !important;
    border-radius: 6px;
    padding: 16px;
    text-align: center;
    cursor: pointer;
    color: var(--papel-dim);
  }
  .drop input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .drop img { max-height: 320px; width: auto; object-fit: contain; }
  .drop:focus-within { outline: 3px solid var(--amarillo); outline-offset: 3px; }

  .msg { margin: 0; min-height: 1.4em; color: var(--verde); }
  #login-msg { color: var(--fucsia); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .btn:disabled { opacity: .6; cursor: wait; }

  .bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
  }
  .bar__right { display: flex; gap: 20px; align-items: center; }
  .link {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    font-weight: 600;
    color: var(--papel);
    text-decoration: underline;
    cursor: pointer;
  }
  .danger { color: var(--fucsia); }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 32px;
    align-items: start;
  }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }

  .list-title { margin-bottom: 12px; }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .list :global(.item) {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    gap: 14px;
    align-items: center;
    background: var(--noche-2);
    padding: 12px;
    border-radius: 6px;
  }
  .list :global(.item--past) { opacity: .55; }
  .list :global(.item img), .list :global(.noimg) {
    width: 64px; height: 80px; object-fit: cover; background: var(--noche); border-radius: 3px;
  }
  .list :global(.item__body) { display: grid; gap: 2px; min-width: 0; }
  .list :global(.item__body strong) { overflow-wrap: anywhere; }
  .list :global(.item__body small) { color: var(--papel-dim); }
  .list :global(.item__actions) { display: grid; gap: 8px; justify-items: end; }
  .list :global(.tags) { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 4px; }
  .list :global(.tag) {
    font-style: normal; font-size: .8rem; font-weight: 600;
    padding: 2px 8px; border-radius: 999px; background: rgba(255, 246, 229, .12);
  }
  .list :global(.tag--hot) { background: var(--fucsia); }
  .list :global(.empty) { color: var(--papel-dim); }
  @media (max-width: 480px) {
    .list :global(.item) { grid-template-columns: 56px 1fr; }
    .list :global(.item__actions) { grid-column: 1 / -1; display: flex; justify-content: flex-end; gap: 20px; }
  }
</style>
